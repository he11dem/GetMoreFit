<Application x:Class="GetMoreFit.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        
        
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>





            <!--<Style x:Key="topMenuButton" TargetType="Button" BasedOn="{StaticResource topMenuButton}">
                <Setter Property="Margin" Value="0 30 0 20"/>
                <Setter Property="Margin" Value="0 30 0 20"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="15"
                                    BorderThickness="1" BorderBrush="#3F888F"
                                >
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>

                </Setter>-->
            <!--</Style>-->


                <Style x:Key="menuButtonIcon" TargetType="Icon:PackIconMaterial">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Width" Value="25"/>
                <Setter Property="Height" Value="25"/>

            </Style>
            <Style x:Key="menuButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Height" Value="50"/>
                <Setter Property="Width" Value="50"/>
                <Setter Property="Margin" Value="0 5"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- Основной контейнер с эффектами -->
                            <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        CornerRadius="15"
                        RenderTransformOrigin="0.5,0.5">

                                <!-- Тень, которая будет анимироваться -->
                                <Border.Effect>
                                    <DropShadowEffect x:Name="shadowEffect" 
                                        Color="#40000000" 
                                        Direction="270" 
                                        BlurRadius="5" 
                                        ShadowDepth="1"
                                        Opacity="0"/>
                                </Border.Effect>

                                <!-- Трансформация для масштабирования -->
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1"/>
                                    </TransformGroup>
                                </Border.RenderTransform>

                                <ContentPresenter HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <!-- Анимация при наведении -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- Анимация фона -->
                                                <ColorAnimation Duration="0:0:0.2"
                                     Storyboard.TargetName="border"
                                     Storyboard.TargetProperty="Background.Color"
                                     To="#6699FF"/>

                                                <!-- Анимация тени -->
                                                <DoubleAnimation Duration="0:0:0.2"
                                       Storyboard.TargetName="shadowEffect"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1"/>
                                                <DoubleAnimation Duration="0:0:0.2"
                                       Storyboard.TargetName="shadowEffect"
                                       Storyboard.TargetProperty="ShadowDepth"
                                       To="3"/>

                                                <!-- Анимация масштаба -->
                                                <DoubleAnimation Duration="0:0:0.2"
                                       Storyboard.TargetName="scaleTransform"
                                       Storyboard.TargetProperty="ScaleX"
                                       To="1.05"/>
                                                <DoubleAnimation Duration="0:0:0.2"
                                       Storyboard.TargetName="scaleTransform"
                                       Storyboard.TargetProperty="ScaleY"
                                       To="1.05"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>

                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- Возврат к исходному состоянию -->
                                                <ColorAnimation Duration="0:0:0.4"
                                     Storyboard.TargetName="border"
                                     Storyboard.TargetProperty="Background.Color"
                                     To="Transparent"/>

                                                <DoubleAnimation Duration="0:0:0.4"
                                       Storyboard.TargetName="shadowEffect"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0"/>
                                                <DoubleAnimation Duration="0:0:0.4"
                                       Storyboard.TargetName="shadowEffect"
                                       Storyboard.TargetProperty="ShadowDepth"
                                       To="1"/>

                                                <DoubleAnimation Duration="0:0:0.4"
                                       Storyboard.TargetName="scaleTransform"
                                       Storyboard.TargetProperty="ScaleX"
                                       To="1"/>
                                                <DoubleAnimation Duration="0:0:0.4"
                                       Storyboard.TargetName="scaleTransform"
                                       Storyboard.TargetProperty="ScaleY"
                                       To="1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <!-- Анимация при нажатии с пружинным эффектом -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- Изменение цвета фона при нажатии -->
                                                <ColorAnimation Duration="0:0:0.1"
                                     Storyboard.TargetName="border"
                                     Storyboard.TargetProperty="Background.Color"
                                     To="#3366CC"/>

                                                <!-- Эффект "утопления" - уменьшение тени и масштаба -->
                                                <DoubleAnimation Duration="0:0:0.1"
                                       Storyboard.TargetName="shadowEffect"
                                       Storyboard.TargetProperty="ShadowDepth"
                                       To="0"/>

                                                <DoubleAnimation Duration="0:0:0.1"
                                       Storyboard.TargetName="scaleTransform"
                                       Storyboard.TargetProperty="ScaleX"
                                       To="0.92"/>

                                                <DoubleAnimation Duration="0:0:0.1"
                                       Storyboard.TargetName="scaleTransform"
                                       Storyboard.TargetProperty="ScaleY"
                                       To="0.92"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>

                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- Возврат с пружинным эффектом -->
                                                <ColorAnimationUsingKeyFrames Storyboard.TargetName="border"
                                                               Storyboard.TargetProperty="Background.Color">
                                                    <LinearColorKeyFrame KeyTime="0:0:0.1" Value="#4D88FF"/>
                                                    <LinearColorKeyFrame KeyTime="0:0:0.3" Value="#6699FF"/>
                                                </ColorAnimationUsingKeyFrames>

                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="shadowEffect"
                                                                Storyboard.TargetProperty="ShadowDepth">
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="4"/>
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="3"/>
                                                </DoubleAnimationUsingKeyFrames>

                                                <!-- Пружинная анимация масштаба -->
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="scaleTransform"
                                                                Storyboard.TargetProperty="ScaleX">
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="1.08"/>
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1.03"/>
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="1.05"/>
                                                </DoubleAnimationUsingKeyFrames>

                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="scaleTransform"
                                                                Storyboard.TargetProperty="ScaleY">
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="1.08"/>
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1.03"/>
                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="1.05"/>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Color x:Key="PrimaryHueLight">#D84315</Color>
            <Color x:Key="PrimaryHueMid">#DFC8AF</Color>
            <!--задний фон меню-->
            <Color x:Key="PrimaryHueDark">#725B53</Color>

            <!-- Вторичные цвета -->
            <Color x:Key="SecondaryAccentLight">#DFC8AF</Color>
            <Color x:Key="SecondaryAccentMid">#16343C</Color>
            <Color x:Key="SecondaryAccentDark">#D84315</Color>

            <!-- Дополнительные цвета -->
            <Color x:Key="TextPrimary">#333333</Color>
            <Color x:Key="TextSecondary">#757575</Color>
            <Color x:Key="BackgroundPrimary">#D84315</Color>
            <Color x:Key="BorderColor">#BDBDBD</Color>


            <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="Century Gothic"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="#9B5757"/>
                <Setter Property="CaretBrush" Value="#9B5757"/>
                <Setter Property="Background" Value="#DFC8AF"/>
                <Setter Property="BorderBrush" Value="#BCA791"/>
                <Setter Property="BorderThickness" Value="3"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="FontFamily" Value="Century Gothic"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="#9B5757"/>
                <Setter Property="CaretBrush" Value="#9B5757"/>
                <Setter Property="Background" Value="#DFC8AF"/>
                <Setter Property="BorderBrush" Value="#BCA791"/>
                <Setter Property="BorderThickness" Value="3"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RoundedMaterialButton" BasedOn="{StaticResource MaterialDesignPaperDarkButton}" TargetType="Button">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border  
            Background="{TemplateBinding Background}"  
            BorderBrush="{TemplateBinding BorderBrush}"  
            BorderThickness="{TemplateBinding BorderThickness}"  
            CornerRadius="20" SnapsToDevicePixels="True">
                                <ContentPresenter  
                HorizontalAlignment="Center"  
                VerticalAlignment="Center"  
                RecognizesAccessKey="True" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource RoundedMaterialButton}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         To="0.8" Duration="0:0:0.2"/>
                                    <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                        To="#DFC8AF" Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         To="1" Duration="0:0:0.4"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
            <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="{StaticResource BackgroundPrimary}" />
            <SolidColorBrush x:Key="BorderColorBrush" Color="{StaticResource BorderColor}" />

            <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="{StaticResource PrimaryHueLight}" />
            <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="{StaticResource PrimaryHueMid}" />
            <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="{StaticResource PrimaryHueDark}" />

            <SolidColorBrush x:Key="SecondaryAccentLightBrush" Color="{StaticResource SecondaryAccentLight}" />
            <SolidColorBrush x:Key="SecondaryAccentMidBrush" Color="{StaticResource SecondaryAccentMid}" />
            <SolidColorBrush x:Key="SecondaryAccentDarkBrush" Color="{StaticResource SecondaryAccentDark}" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
