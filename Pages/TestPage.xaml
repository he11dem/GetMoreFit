<Page x:Class="GetMoreFit.Pages.TestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GetMoreFit.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="1920"
      Title="TestPage">

    <Grid>
        <!-- Основной контейнер -->
        <Border Margin="40" CornerRadius="10" Background="#FF1A1A2E">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Верхний блок с текстом -->
                <StackPanel Grid.Row="0" Margin="20,20,20,10">
                    <TextBlock Text="DIGITAL" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="CONTROL" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="#FF4FC3F7"
                               HorizontalAlignment="Center"
                               Margin="0,-10,0,0"/>

                    <TextBlock Text="THINKERS" 
                               FontSize="16" 
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

                    <TextBlock Text="SIP: 4-16" 
                               FontSize="14" 
                               Foreground="#FFB0BEC5"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Центральный блок с основным текстом -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="We're thrilled to welcome you back for the top-national"
                               Foreground="White"
                               FontSize="18"
                               TextAlignment="Center"/>

                    <TextBlock Text="The Awesome Conference."
                               Foreground="#FF4FC3F7"
                               FontSize="22"
                               FontWeight="Bold"
                               TextAlignment="Center"/>

                    <TextBlock Text="AMSTERDAM"
                               Foreground="White"
                               FontSize="32"
                               TextAlignment="Center"
                               Margin="0,20,0,0"
                               FontFamily="Druk Wide Bold"
                               
                               />
                </StackPanel>

                <!-- Нижний блок с кнопками -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" 
                            HorizontalAlignment="Center" Margin="0,0,0,30">
                    <Button Content="Booking" 
                            Width="120" Height="40" 
                            Background="#FF4FC3F7"
                            Foreground="White"
                            FontWeight="Bold"
                            Margin="0,0,20,0"
                            Command="{Binding BookingCommand}"/>

                    <Button Content="Get Tickets" 
                            Width="120" Height="40" 
                            Background="Transparent"
                            Foreground="#FF4FC3F7"
                            BorderBrush="#FF4FC3F7"
                            BorderThickness="2"
                            FontWeight="Bold"
                            Command="{Binding GetTicketsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
