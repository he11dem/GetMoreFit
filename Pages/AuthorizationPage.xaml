<Page x:Class="GetMoreFit.Pages.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GetMoreFit.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      MinWidth="800" 
      MinHeight="600"
      Title="AuthorizationPage">
    <Page.Resources>
        <Style x:Key="ModernTextWithShadow" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#AA000000" 
                                      Direction="320" 
                                      ShadowDepth="4" 
                                      BlurRadius="8" 
                                      Opacity="0.7"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="200"/>
            <RowDefinition Height="*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="/GetMoreFit;component/Resources/Images/gym.jpg" 
                    Stretch="UniformToFill"/>
        </Grid.Background>
        <TextBlock Text="MORE" 
                   Style="{StaticResource ModernTextWithShadow}"
                   FontSize="30"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="94,58,0,0"
                   TextWrapping="WrapWithOverflow"
                   >
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="-14.768"/>
                    <RotateTransform/>
                    <TranslateTransform Y="-1.956"/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>

        <TextBlock Text="FITNESS" 
                   Style="{StaticResource ModernTextWithShadow}"
                   FontSize="28"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top" 
                   Margin="66,122,0,0" 
                   Width="114"
                   TextWrapping="WrapWithOverflow"
                   >
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="-15.423"/>
                    <RotateTransform/>
                    <TranslateTransform Y="-22.802"/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock Text="GET" 
                   Style="{StaticResource ModernTextWithShadow}"
                   FontSize="30"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Margin="38,69,0,0"
                   TextWrapping="WrapWithOverflow">
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="-16.002"/>
                    <RotateTransform/>
                    <TranslateTransform Y="7.98"/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>
        <Border HorizontalAlignment="Center" 
                Width="1000" 
                Height="650" 
                Grid.ColumnSpan="3" 
                BorderThickness="5"
                BorderBrush="#000046"
                Grid.RowSpan="3" 
                CornerRadius="20" 
                Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                      ShadowDepth="3"
                      Color="#20000000"
                      Opacity="0.4"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="120"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition />
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition MinHeight="120"/>
                    <RowDefinition Height="120"/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="txtError" 
                           Foreground="#B00000" 
                           Margin="0,55,0,0" 
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Grid.Row="3"
                           FontSize="18"
                           Width="250"
                           Height="60"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock Text="C возвращением!" 
                           FontSize="30"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Foreground="Black"
                           Grid.Column="1"
                           FontFamily="Century Goatic"
                           FontWeight="Medium"
                           Margin="0 0 0 0">
                </TextBlock>
                <TextBlock Text="Мы так рады видеть вас снова!" 
                           FontSize="26"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Bottom"
                           Foreground="Black"
                           Grid.Column="1"
                           Margin="0 0 0 20">
                </TextBlock>
                <TextBlock Text="Логин *" 
                           FontSize="26"
                           HorizontalAlignment="Right" 
                           VerticalAlignment="Top"
                           Foreground="Black"
                           FontFamily="Century Gothic"
                           FontWeight="Bold"
                           Grid.Row="1" 
                           Grid.Column="0"
                           Margin="0 15 15 0"
                           />
               <TextBlock Text="Пароль *" 
                           FontSize="26"
                           HorizontalAlignment="Right" 
                           VerticalAlignment="Top"
                           Foreground="Black"
                           FontFamily="Century Gothic"
                           FontWeight="Bold"
                           Grid.Row="2" 
                           Grid.Column="0"
                          Margin="0 5 0 0"
                          />
                <TextBox Grid.Column="0"
                         Name="LoginTbx"
                         Grid.Row="1"
                         FontFamily="Century Gothic"
                         Foreground="White"
                         FontSize="28"
                         Background="#6699FF"
                         BorderBrush="#000046"
                         MaxLength="10"
                         BorderThickness="3"
                         Margin="5 0 0 10"
                         Height="50"
                         VerticalAlignment="Bottom"
                         HorizontalAlignment="Center"
                         Width="450"
                         Grid.ColumnSpan="2"
                         >
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="BorderBrush" Value="LightGray"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="BorderBrush" Value="Red"/>
                                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                        <TextBox.Template>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
                <PasswordBox Grid.Column="0" 
                             Name="PasswordPbx"
                             Grid.Row="2"
                             FontFamily="Century Gothic"
                             FontSize="28"
                             Foreground="White"
                             Background="#6699FF"
                             BorderBrush="#000046"   
                             BorderThickness="3"
                             Grid.ColumnSpan="2"
                             MaxLength="10"
                             Height="50"
                             Width="450"
                             >
                    <PasswordBox.Template>
                        <ControlTemplate TargetType="{x:Type PasswordBox}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <!-- Добавляем CornerRadius -->
                                <ScrollViewer x:Name="PART_ContentHost" 
                                              Margin="{TemplateBinding Padding}" 
                                              IsTabStop="False"/>
                            </Border>
                        </ControlTemplate>
                    </PasswordBox.Template>
                </PasswordBox>
                <TextBlock FontSize="18"
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Bottom"
                           Foreground="Black"
                           Grid.Column="0"
                           Grid.Row="2"
                           Grid.ColumnSpan="2"
                           Margin="35 0 0 35">
                    <Hyperlink NavigateUri="/Pages/RequestPassPage.xaml" 
                               FontFamily="Century Gothic"
                               TextDecorations="None"
                               Foreground="Black"
                               RequestNavigate="Hyperlink_RequestNavigate">Забыли пароль?
                    </Hyperlink>
                </TextBlock>
                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Name="LoginBtn"
                        Height="50"
                        Grid.Column="0"
                        Grid.Row="3"
                        Background="#6699FF"
                        BorderBrush="#000046"
                        Content="войти"
                        FontSize="35"
                        VerticalAlignment="Top"
                        FontFamily="Century Gothic"
                        Foreground="White"
                        Grid.ColumnSpan="2"
                        Margin="40 0 40 0" Click="LoginBtn_Click">
                </Button>
                
            </Grid>
        </Border>
    </Grid>
</Page>
