<Page x:Class="GetMoreFit.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GetMoreFit.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="1920"
      Title="Крутая страничка">
    <Page.Resources>
        <!-- Современный стиль текста с тенью -->
        <Style x:Key="ModernTextWithShadow" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect 
                    Color="#AA000000" 
                    Direction="320" 
                    ShadowDepth="4" 
                    BlurRadius="8" 
                    Opacity="0.7"/>
                </Setter.Value>
            </Setter>
        </Style>

        <FontFamily x:Key="CustomFont">
            pack://application:,,,/fonts/#Manrope-VariableFont_wght
        </FontFamily>
    </Page.Resources>
    <Grid Background="#ebebeb">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border Margin="15,25,244,24" Grid.RowSpan="7" CornerRadius="20" Grid.ColumnSpan="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#6699FF" Offset="0.0"/>
                    <GradientStop Color="#FF00BFFF" Offset="0.5"/>
                    <GradientStop Color="#000046" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect 
                                Direction="320"
                                ShadowDepth="2"
                                BlurRadius="15"
                                Opacity="0.8"
                                RenderingBias="Quality"/>
            </Border.Effect>
            <!-- Добавляем контейнер для текстовых элементов -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="GET" 
                           Style="{StaticResource ModernTextWithShadow}"
                           FontSize="30"
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Top"
                           Margin="24,54,0,0">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleY="-16.002"/>
                            <RotateTransform/>
                            <TranslateTransform Y="7.98"/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <TextBlock Text="MORE" 
                           Style="{StaticResource ModernTextWithShadow}"
                           FontSize="30"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="80,44,0,0">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleY="-14.768"/>
                            <RotateTransform/>
                            <TranslateTransform Y="-1.956"/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <TextBlock Text="FITNESS" 
                           Style="{StaticResource ModernTextWithShadow}"
                           FontSize="28"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top" 
                           Margin="43,102,0,0" 
                           Width="114">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleY="-15.423"/>
                            <RotateTransform/>
                            <TranslateTransform Y="-22.802"/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock Text="GET" 
                           Style="{StaticResource ModernTextWithShadow}"
                           FontSize="30"
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Top"
                           Margin="28,57,0,0" 
                           Grid.Column="1" 
                           Grid.Row="5">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleY="-16.002"/>
                            <RotateTransform/>
                            <TranslateTransform Y="7.98"/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <TextBlock Text="MORE" 
                           Style="{StaticResource ModernTextWithShadow}"
                           FontSize="30"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="86,46,0,0" 
                           Grid.Column="1" 
                           Grid.Row="5">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleY="-14.768"/>
                            <RotateTransform/>
                            <TranslateTransform Y="-1.956"/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <TextBlock Text="FITNESS" 
                           Style="{StaticResource ModernTextWithShadow}"
                           FontSize="28"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top" 
                           Margin="44,104,0,0" 
                           Width="114" 
                           Grid.Column="1" 
                            Grid.Row="5">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleY="-15.423"/>
                            <RotateTransform/>
                            <TranslateTransform Y="-22.802"/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
        </Border>
        <Border Grid.ColumnSpan="2" Margin="45,16,275,42" Grid.RowSpan="5" Grid.Row="1" Background="White" CornerRadius="30">
            <!-- Добавляем контейнер Grid для правильного размещения TextBlock -->
            <Grid>
                <TextBlock Text="Попробуй" 
                   FontSize="26"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Margin="86,57,0,0"
                   Foreground="Black" 
                   Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                   FontFamily="Manrope"
                   Width="141">
                </TextBlock>

                <TextBlock Text="как тренер." 
                   FontSize="26"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Margin="86,93,0,0"
                   Foreground="Gray" 
                   Width="141"
                   Style="{StaticResource MaterialDesignBody1TextBlock}"
                           FontFamily="AppFont">

                </TextBlock>

                <Image Source="/Resources/Images/shedule.png" Margin="58,136,208,462"/>
                <Image Source="/Resources/Images/plan.png" Margin="202,133,64,463" RenderTransformOrigin="-0.228,0.424"/>
                <TextBlock Text="составляй расписание" 
                    FontSize="14"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"
                    Margin="12,192,0,0"
                    Foreground="Black" 
                    Width="154" RenderTransformOrigin="0.458,0.634"/>
                <TextBlock Text="выполняй план" 
                    FontSize="14"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"
                    Margin="178,192,0,0"
                    Foreground="Black" 
                    Width="105" RenderTransformOrigin="0.458,0.634"/>

                <TextBlock Text="Попробуй" 
                           FontSize="26"
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Top"
                           Margin="90,296,0,0"
                           Foreground="Black" 
                           Width="128">
                </TextBlock>
                <TextBlock Text="как админ." 
                           FontSize="26"
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Top"
                           Margin="90,330,0,0"
                           Foreground="Gray" 
                           Width="134"
                           FontFamily="TT Hoves Pro">
                </TextBlock>
                <Image Source="/Resources/Images/client.png" Margin="48,379,218,219"/>
                <TextBlock Text="новые клиенты" 
                    FontSize="14"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"
                    Margin="24,437,0,0"
                    Foreground="Black" 
                    Width="107" RenderTransformOrigin="0.458,0.634"/>
                <Image Source="/Resources/Images/uchet.png" Margin="208,377,58,220"/>
                <TextBlock Text="учет клиентов" 
                    FontSize="14"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"
                    Margin="180,436,0,0"
                    Foreground="Black" 
                    Width="98" RenderTransformOrigin="0.458,0.634"/>
                <Button x:Name="AdminLoginBtn"
                        Background="#6699FF"
                        BorderThickness="0"
                        Content="Войти"
                        Foreground="White"
                        FontSize="14"
                        FontFamily="Montserrat"
                        Cursor="Hand"
                        Margin="49,460,51,121" Click="AdminLoginBtn_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#28AEED"/>
                            <!-- Добавляем эффект по умолчанию (прозрачный) -->
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Opacity="0"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2788EF"/>
                                    <!-- Включаем тень при наведении -->
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect 
                                Color="#2788EF" 
                                BlurRadius="15" 
                                Opacity="0.7" 
                                ShadowDepth="0"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="150" 
                    Height="40"
                    CornerRadius="20"
                    Background="{TemplateBinding Background}"
                                Effect="{TemplateBinding Effect}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="TrainerLoginBtn"
                        Background="#6699FF"
                        BorderThickness="0"
                        Content="Войти"
                        Foreground="White"
                        FontSize="14"
                        FontFamily="Montserrat"
                        Cursor="Hand"
                        Margin="45,208,55,373" Click="TrainerLoginBtn_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#28AEED"/>
                            <!-- Добавляем эффект по умолчанию (прозрачный) -->
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Opacity="0"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2788EF"/>
                                    <!-- Включаем тень при наведении -->
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect 
                                                        Color="#2788EF" 
                                                        BlurRadius="15" 
                                                        Opacity="0.7" 
                                                        ShadowDepth="0"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="150" 
                                    Height="40"
                                    CornerRadius="20"
                                    Background="{TemplateBinding Background}"
                                    Effect="{TemplateBinding Effect}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
        <Border Margin="94,24,135,22" Grid.RowSpan="7" CornerRadius="20" Grid.Column="1">
            <!-- Фон с градиентом -->
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#6699FF" Offset="0.0"/>
                    <GradientStop Color="#FF00BFFF" Offset="0.5"/>
                    <GradientStop Color="#000046" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <!-- Стилизованная тень -->
            <Border.Effect>
                <DropShadowEffect 
                    Direction="320"
                    ShadowDepth="2"
                    BlurRadius="15"
                    Opacity="0.8"
                    RenderingBias="Quality"/>
            </Border.Effect>

            <!-- Дополнительная обводка для акцента -->
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#80FFFFFF" Offset="0.2"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.8"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>2</Border.BorderThickness>
        </Border>
        <Border CornerRadius="50" Grid.Column="1" Grid.ColumnSpan="5" Margin="194,24,137,26" Grid.RowSpan="7">
            <!-- Основной контейнер для свайпа -->
            <Grid x:Name="SwipeContainer">
                <!-- Фоновое изображение с эффектами -->
                <Border x:Name="ImageBorder" CornerRadius="50">
                    <Border.Background>
                        <ImageBrush x:Name="MainImageBrush" ImageSource="/Resources/Images/strong_girl.jpg" Stretch="UniformToFill"/>
                    </Border.Background>

                    <Border CornerRadius="50" BorderThickness="5" Opacity="0.3" Margin="0,-5,-3,0">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6699FF" Offset="0"/>
                                <GradientStop Color="#FF00BFFF" Offset="0.5"/>
                                <GradientStop Color="#000046" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                <GradientStop Color="Black" Offset="0.5"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>

                <!-- Индикаторы страниц -->
                <StackPanel x:Name="IndicatorsPanel" Orientation="Horizontal" 
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                   Margin="0,0,0,20"/>
            </Grid>
        </Border>
        <Border Margin="200,23,29,28" Grid.RowSpan="7" CornerRadius="20" Grid.Column="5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#6699FF" Offset="1.0"/>
                    <GradientStop Color="#FF00BFFF" Offset="0.5"/>
                    <GradientStop Color="#000046" Offset="0.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect 
                                  Direction="320"
                                  ShadowDepth="2"
                                  BlurRadius="15"
                                  Opacity="0.8"
                                  RenderingBias="Quality"/>
            </Border.Effect>
        </Border>
    </Grid>
</Page>
