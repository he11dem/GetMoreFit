<Page x:Class="GetMoreFit.Pages.SlidePanelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
       xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
       xmlns:lvc="clr-namespace:LiveCharts;assembly=LiveCharts"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="150"
      Title="SlidePanelPage">

    <Page.Resources>
        <Style x:Key="AnimatedSidebarStyle" TargetType="Border">
            <Setter Property="Background" Value="#6699FF"/>
            <Setter Property="CornerRadius" Value="30"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="-30"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Width" Value="70"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation 
                                Storyboard.TargetProperty="RenderTransform.X"
                                To="0" 
                                Duration="0:0:0.3"
                                DecelerationRatio="0.5"/>
                                <DoubleAnimation 
                                Storyboard.TargetProperty="Width"
                                To="110" 
                                Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation 
                                Storyboard.TargetProperty="RenderTransform.X"
                                To="-30" 
                                Duration="0:0:0.3"
                                AccelerationRatio="0.5"/>
                                <DoubleAnimation 
                                Storyboard.TargetProperty="Width"
                                To="70" 
                                Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <Grid Background="#ebebeb" ClipToBounds="True">
        <Grid Background="#ebebeb" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>
            <Border x:Name="SideMenuBarPrimary"
                    Grid.Column="0"
                    Style="{StaticResource AnimatedSidebarStyle}"
                    Width="70"
                    Height="350"
                    VerticalAlignment="Top"
                    Background="#6699FF"
                    CornerRadius="30"
                    Margin="10 25 0 0" Grid.RowSpan="2">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="MenuTransformPartOne" X="-30"/>
                </Border.RenderTransform>

                <Grid>
                    <StackPanel VerticalAlignment="Top">
                        <Button Style="{StaticResource menuButton}" >
                            <Icon:PackIconMaterial Style="{StaticResource menuButtonIcon}"/>
                        </Button>
                        <Separator Background="White" 
                       Margin="15 10 15 0"
                       Height="1"
                       Opacity="0.7">
                            <Separator.Style>
                                <Style TargetType="Separator">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="Background" Value="#AADDFF"/>
                                            <Setter Property="Height" Value="1.5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Separator.Style>
                        </Separator>
                        <Button x:Name="HomeBtn" Style="{StaticResource menuButton}" Click="HomeBtn_Click">
                            <Icon:PackIconMaterial Kind="HomeAccount" Margin="0 0 0 0" Style="{StaticResource menuButtonIcon}"/>
                        </Button>
                        <Button x:Name="DocBtn"  Style="{StaticResource menuButton}" Click="DocBtn_Click">
                            <Icon:PackIconMaterial Kind="DockBottom" Style="{StaticResource menuButtonIcon}"/>
                        </Button>
                        <Button x:Name="CalendarBtn"   Style="{StaticResource menuButton}" Click="CalendarBtn_Click">
                            <Icon:PackIconMaterial Kind="Calendar" Style="{StaticResource menuButtonIcon}"/>
                        </Button>
                        <Button x:Name="TrackerBtn" Style="{StaticResource menuButton}" Click="TrackerBtn_Click">
                            <Icon:PackIconMaterial Kind="AlarmMultiple" Style="{StaticResource menuButtonIcon}"/>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="SideMenuBarSecondary"
                    Style="{StaticResource AnimatedSidebarStyle}"
                    Grid.Column="0"
                    Width="70"
                    Height="300"
                    VerticalAlignment="Bottom"
                    Background="#6699FF"
                    CornerRadius="30"
                    Margin="10,0,10,80" Grid.Row="1">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="MenuTransformPartTwo" X="-30"/>
                </Border.RenderTransform>

                <Grid>
                    <StackPanel VerticalAlignment="Top">

                        <Button x:Name="SettingsBtn" Style="{StaticResource menuButton}" Margin="0 35 0 0" Click="SettingsBtn_Click">
                            <Icon:PackIconMaterial Kind="FileSettings"  Margin="0 10 0 0" Style="{StaticResource menuButtonIcon}"/>
                        </Button>
                        <Button x:Name="UserBtn" Style="{StaticResource menuButton}" Margin="0 35 0 0" Click="UserBtn_Click">
                            <Icon:PackIconMaterial Kind="MouseRightClickOutline"  Margin="0 10 0 0" Style="{StaticResource menuButtonIcon}"/>
                        </Button>
                        <Button x:Name="ExitBtn"  Style="{StaticResource menuButton}" Margin="0 35 0 0" Click="ExitBtn_Click">
                            <Icon:PackIconMaterial Kind="ExitToApp"  Margin="0 10 0 0" Style="{StaticResource menuButtonIcon}"/>
                        </Button>
                        <TextBlock x:Name="TimeTextBlock" 
                                   FontSize="15" 
                                   Text="{Binding CurrentTime}" 
                                   Foreground="White" 
                                   FontFamily="Century Goatic" 
                                   Width="50"
                                   Margin="0 5 0 0"
                                   >
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                    Storyboard.TargetProperty="Opacity"
                                                    From="0.7" To="1.0"
                                                    Duration="0:0:0.5"
                                                    AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="ContentGrid" Grid.Column="1">
            <Frame x:Name="NewFrame" NavigationUIVisibility="Hidden" />
        </Grid>
    </Grid>
</Page>
