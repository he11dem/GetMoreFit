<Page x:Class="GetMoreFit.Pages.AdminHomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GetMoreFit.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="AdminHomePage">

    <Page.Resources>

        <Style x:Key="ModernTextWithShadow" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect 
            Color="#AA000000" 
            Direction="320" 
            ShadowDepth="4" 
            BlurRadius="8" 
            Opacity="0.7"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrainerCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <Setter.Value>
                    <ImageBrush ImageSource="/Resources/Images/caruselone.jpg" Stretch="UniformToFill"/>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation 
                                Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1.05" 
                                Duration="0:0:0.2"/>
                                <DoubleAnimation 
                                Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                To="1.05" 
                                Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation 
                                Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1" 
                                Duration="0:0:0.2"/>
                                <DoubleAnimation 
                                Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                To="1" 
                                Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="#ebebeb" Margin="130 0 0 0">
        <!-- Колонки -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- Левая часть (приветствие, вода/калории) -->
            <ColumnDefinition Width="*"/>
            <!-- Центр (тренеры, воркшопы) -->
            <ColumnDefinition Width="*"/>
            <!-- Правая часть (статистика, цели) -->
        </Grid.ColumnDefinitions>

        <!-- Строки -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Приветствие -->
            <RowDefinition Height="Auto"/>
            <!-- Статистика (Water/Calorie/Weight) -->
            <RowDefinition Height="*"/>
            <!-- Тренеры + Воркшопы -->
            <RowDefinition Height="Auto"/>
            <!-- Daily Hustling -->
            <RowDefinition Height="Auto"/>
            <!-- Milestone + Daily Target -->
        </Grid.RowDefinitions>
        <Border Grid.Column="0" 
                Grid.Row="1" 
                Height="400" 
                Margin="20 40 20 0" 
                Background="#ffffff" 
                CornerRadius="30">
            <Border.Effect>
                <DropShadowEffect 
                                Color="#20000000"
                                Direction="270"
                                ShadowDepth="5"
                                BlurRadius="15"
                                Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Лучшие тренера" 
                           FontWeight="Medium" 
                           HorizontalAlignment="Left" 
                           Margin="20 45 0 0" 
                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                           FontFamily="CustomFont"
                           FontSize="22"
                           Grid.ColumnSpan="2"
                           />
                <Button Style="{StaticResource MaterialDesignFlatButton}" 
                        x:Name="TrainerBtn"
                    HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Grid.Column="1"
                        Foreground="#6699FF"
                        Height="35"
                        Grid.ColumnSpan="2"
                        FontSize="22"
                        Content="Посмотреть всех >>"
                        Margin="0,38,10,0" Click="TrainerBtn_Click" ></Button>
                <WrapPanel Grid.ColumnSpan="3" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Height="290" 
                           Width="500" 
                           Margin="0 55 0 0">
                    <Border CornerRadius="10" 
                            Padding="10" 
                            Style="{StaticResource TrainerCardStyle}"
                            Margin="0 10 10 10" 
                            BorderBrush="#ebebeb"
                            Height="250"
                            Width="150">
                        <Border.Background>
                            <ImageBrush ImageSource="/GetMoreFit;component/Resources/Images/caruselone.jpg" Stretch="UniformToFill"/>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="Альмир Загиров" 
                                       HorizontalAlignment="Left" 
                                       VerticalAlignment="Center" 
                                       FontWeight="Bold" 
                                       FontSize="14" 
                                       Foreground="#ebebeb"
                                       Style="{StaticResource ModernTextWithShadow}"/>
                            <TextBlock Text="Fitness Trainer" 
                                       HorizontalAlignment="Left" 
                                       FontWeight="Bold"
                                       Foreground="#ebebeb"
                                       FontSize="15" 
                                       Style="{StaticResource ModernTextWithShadow}" />

                        </StackPanel>
                    </Border>
                    <Border CornerRadius="10" 
                            Padding="10" 
                            Style="{StaticResource TrainerCardStyle}"
                            Margin="0 10 10 10" 
                            BorderBrush="#ebebeb"
                            Height="250"
                            Width="150">
                        <Border.Background>
                            <ImageBrush ImageSource="/GetMoreFit;component/Resources/Images/caruselone.jpg" Stretch="UniformToFill"/>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="Альмир Загиров" 
                                       HorizontalAlignment="Left" 
                                       VerticalAlignment="Center" 
                                       FontWeight="Bold" 
                                       FontSize="15" 
                                       Foreground="#ebebeb"
                                       Style="{StaticResource ModernTextWithShadow}"/>
                            <TextBlock Text="Fitness Trainer" 
                                       HorizontalAlignment="Left" 
                                       FontWeight="Bold"
                                       Foreground="#ebebeb"
                                       FontSize="15" 
                                       Style="{StaticResource ModernTextWithShadow}" />

                        </StackPanel>
                    </Border>
                    <Border CornerRadius="10" 
                            Padding="10" 
                            Style="{StaticResource TrainerCardStyle}"
                            Margin="0 10 10 10" 
                            BorderBrush="#ebebeb"
                            Height="250"
                            Width="150">
                        <Border.Background>
                            <ImageBrush ImageSource="/GetMoreFit;component/Resources/Images/caruselone.jpg" Stretch="UniformToFill"/>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="Альмир Загиров" 
                                       HorizontalAlignment="Left" 
                                       VerticalAlignment="Center" 
                                       FontWeight="Bold" 
                                       FontSize="15" 
                                       Foreground="#ebebeb"
                                       Style="{StaticResource ModernTextWithShadow}"/>
                            <TextBlock Text="Fitness Trainer" 
                                       HorizontalAlignment="Left" 
                                       FontWeight="Bold"
                                       Foreground="#ebebeb"
                                       FontSize="15" 
                                       Style="{StaticResource ModernTextWithShadow}" />

                        </StackPanel>
                    </Border>
                </WrapPanel>

            </Grid>
        </Border>
        <Border Grid.Column="0" 
                Grid.Row="2" 
                Height="400" 
                VerticalAlignment="Top"
                Margin="20 20 20 0" 
                Background="#ffffff" 
                CornerRadius="30">
            <Border.Effect>
                <DropShadowEffect 
                        Color="#20000000"
                        Direction="270"
                        ShadowDepth="5"
                        BlurRadius="15"
                        Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Наши клиенты" 
                           FontWeight="Medium" 
                           HorizontalAlignment="Left" 
                           Margin="20 45 0 0" 
                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                           FontFamily="CustomFont"
                           FontSize="22"
                           Grid.ColumnSpan="2"/>
                <Button Style="{StaticResource MaterialDesignFlatButton}" 
                        x:Name="ClientBtn"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Grid.Column="1"
                        Foreground="#6699FF"
                        Height="35"
                        Grid.ColumnSpan="2"
                        FontSize="22"
                        Content="Посмотреть всех >>"
                        Margin="0,38,10,0" Click="ClientBtn_Click" ></Button>
                <WrapPanel Grid.ColumnSpan="3" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Height="290" 
                           Width="500" 
                           Margin="0 55 0 0">
                    <Border CornerRadius="10" 
                            Padding="10" 
                            Style="{StaticResource TrainerCardStyle}"
                            Margin="0 10 10 10" 
                            BorderBrush="#ebebeb"
                            Height="250"
                            Width="150">
                        <Border.Background>
                            <ImageBrush ImageSource="/GetMoreFit;component/Resources/Images/caruselone.jpg" Stretch="UniformToFill"/>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="Альмир Загиров" 
                                       HorizontalAlignment="Left" 
                                       VerticalAlignment="Center" 
                                       FontWeight="Bold" 
                                       FontSize="14" 
                                       Foreground="#ebebeb"
                                       Style="{StaticResource ModernTextWithShadow}"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="10" 
                            Padding="10" 
                            Style="{StaticResource TrainerCardStyle}"
                            Margin="0 10 10 10" 
                            BorderBrush="#ebebeb"
                            Height="250"
                            Width="150">
                        <Border.Background>
                            <ImageBrush ImageSource="/GetMoreFit;component/Resources/Images/caruselone.jpg" Stretch="UniformToFill"/>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="Альмир Загиров" 
                                       HorizontalAlignment="Left" 
                                       VerticalAlignment="Center" 
                                       FontWeight="Bold" 
                                       FontSize="15" 
                                       Foreground="#ebebeb"
                                       Style="{StaticResource ModernTextWithShadow}"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="10" 
                            Padding="10" 
                            Style="{StaticResource TrainerCardStyle}"
                            Margin="0 10 10 10" 
                            BorderBrush="#ebebeb"
                            Height="250"
                            Width="150">
                        <Border.Background>
                            <ImageBrush ImageSource="/GetMoreFit;component/Resources/Images/caruselone.jpg" Stretch="UniformToFill"/>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="Альмир Загиров" 
                                       HorizontalAlignment="Left" 
                                       VerticalAlignment="Center" 
                                       FontWeight="Bold" 
                                       FontSize="15" 
                                       Foreground="#ebebeb"
                                       Style="{StaticResource ModernTextWithShadow}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
