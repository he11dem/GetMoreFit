<Page x:Class="GetMoreFit.Pages.EditTrainersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GetMoreFit.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="EditTrainersPage">
    <Page.Resources>
        <Style x:Key="ModernTextWithShadow" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#AA000000" 
                              Direction="320" 
                              ShadowDepth="4" 
                              BlurRadius="8" 
                              Opacity="0.7"/>
            </Setter.Value>
        </Setter>
    </Style>
    </Page.Resources>
    <Grid Background="#ebebeb" Margin="130 0 0 0">
        <Border HorizontalAlignment="Left" 
        Width="1500" 
        Height="1000" 
        Margin="130 0 130 0"
        BorderThickness="5"
        BorderBrush="#000046"
        CornerRadius="20" 
        Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                          ShadowDepth="3"
                          Color="#20000000"
                          Opacity="0.4"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="120"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition />
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition MinHeight="120"/>
                    <RowDefinition Height="120"/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel Margin="25 15 15 0">
                    <StackPanel Margin="25 15 15 0">
                        <Border x:Name="ImageContainer"
                        Width="250"
                        Height="230"
                        Margin="10 25 0 5"
                        Background="#EEEEEE"
                        CornerRadius="4"
                        Cursor="Hand">
                            <Grid>
                                <Image x:Name="LoadImage"
                               Stretch="UniformToFill">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,200,200" RadiusX="4" RadiusY="4"/>
                                    </Image.Clip>
                                </Image>

                                <StackPanel x:Name="Placeholder"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    TextElement.FontSize="50"
                                    TextElement.Foreground="#999999">
                                    <TextBlock Text="🖼️" 
                                       HorizontalAlignment="Center"/>
                                    <TextBlock Text="Загрузить фото"
                                       FontSize="16"
                                       Margin="0 10 0 0"
                                       MouseDown="LoadImage_MouseDown"
                                       HorizontalAlignment="Center"
                                       Cursor="Hand">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="#6699FF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <TextBlock.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectImageCommand}"/>
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0.8"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E0E0E0"/>
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="BorderBrush" Value="#6699FF"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                    To="#E0E0E0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     To="0.8" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                    To="#EEEEEE" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <Button 
                Grid.Row="1"
                 Style="{StaticResource MaterialDesignRaisedButton}" 
                 x:Name="AddNewClientBtn"
                 Grid.Column="0"
                 VerticalAlignment="Top"
                 Width="150"
                 Margin="0 55 100 0"
                 Padding="12,6"
                 HorizontalContentAlignment="Center">

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon 
                         Kind="ProgressAlert" 
                         Width="20"
                         Height="20"
                         Margin="0,0,8,0"/>
                        <TextBlock Text="Прогресс" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TabControl Width="800" Height="400" Margin="0 0 0 0" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2">
                    <TabItem Header="Основные данные">
                        <StackPanel Margin="10">
                            <StackPanel VerticalAlignment="Top" 
                                Orientation="Horizontal" >
                                <TextBlock Margin="0 0 10 0" 
                                   Text="Таб №" 
                                   FontSize="16" 
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                                <TextBox Width="100" 
                                 x:Name="TabNumberTbx" 
                                 Style="{StaticResource 
                                 MaterialDesignTextBoxBase}"/>
                                <TextBlock Margin="150 0 0 0" 
                                   FontSize="16"
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"
                                   VerticalAlignment="Center" 
                                   Text="Пол"/>
                                <CheckBox Margin="10 0 0 0" 
                                  Height="25" 
                                  Width="35"  
                                  VerticalAlignment="Center" 
                                  Style="{StaticResource MaterialDesignActionToggleButton}" 
                                  Content="М"/>
                                <CheckBox Margin="10 0 0 0" 
                                  VerticalAlignment="Center" 
                                  Height="25" 
                                  Width="35" 
                                  Style="{StaticResource MaterialDesignActionToggleButton}" Content="ж" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0 20 0 0" 
                                VerticalAlignment="Center" 
                                Orientation="Horizontal">
                                <TextBlock Text="Фамилия" 
                                   FontSize="16" 
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                                <TextBlock Margin="150 0 0 0" Text="Имя" 
                                   FontSize="16" 
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                                <TextBlock Margin="150 0 0 0"
                                   Text="Отчество"
                                   FontSize="16" 
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                            </StackPanel>
                            <StackPanel Margin="0 2 0 0" VerticalAlignment="Top" Orientation="Horizontal">
                                <TextBox Width="190" x:Name="SurNameTbx" 
                                 Style="{StaticResource MaterialDesignTextBoxBase}"></TextBox>
                                <TextBox Width="165" 
                                 x:Name="NameTbx"
                                 Style="{StaticResource MaterialDesignTextBoxBase}" 
                                 Margin="10 0 0 0"></TextBox>
                                <TextBox Width="160" Margin="10 0 0 0"
                                 Style="{StaticResource MaterialDesignTextBoxBase}" 
                                 x:Name="PatronomycTbx"/>
                            </StackPanel>
                            <StackPanel Margin="0 20 0 0" Orientation="Horizontal" VerticalAlignment="Top">
                                <GroupBox Header="Место рождения" FontSize="16" Style="{StaticResource MaterialDesignCardGroupBox}"  Width="300" Height="200">
                                    <GroupItem>
                                        <StackPanel Margin="5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="16" 
                                                   Text="Страна" 
                                                   Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                                                <TextBox Margin="5 0 0 0" 
                                                 Width="205" 
                                                 Style="{StaticResource MaterialDesignTextBoxBase}"></TextBox>
                                            </StackPanel>
                                            <StackPanel Margin="0 5 0 0" Orientation="Horizontal">
                                                <TextBlock FontSize="16" 
                                                   Text="Город" 
                                                   Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                                                <TextBox Margin="5 0 0 0" 
                                                 Width="212"
                                                 Style="{StaticResource MaterialDesignTextBoxBase}"
                                                 />
                                            </StackPanel>
                                            <StackPanel Margin="0 5 0 0" Orientation="Horizontal">
                                                <TextBlock FontSize="16"
                                                   Style="{StaticResource MaterialDesignBody1TextBlock}"
                                                   Text="Район"/>
                                                <TextBox Margin="5 0 0 0" 
                                                 Width="212" 
                                                 Style="{StaticResource MaterialDesignTextBoxBase}"></TextBox>
                                            </StackPanel>
                                            <StackPanel Margin="0 5 0 0" Orientation="Horizontal">
                                                <TextBlock Text="Область" 
                                                   FontSize="16" 
                                                   Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                                                <TextBox Margin="5 0 0 0" Width="200" 
                                                 Style="{StaticResource MaterialDesignTextBoxBase}"></TextBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupItem>
                                </GroupBox>
                                <StackPanel Margin="40 0 0 0" Orientation="Vertical">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock 
                                    Text="Дата рождения" FontSize="16" Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                                        <DatePicker Style="{StaticResource MaterialDesignDatePicker}"
                                            Margin="5"></DatePicker>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="Семейное положение" FontSize="16" Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                                        <ComboBox Width="200" Style="{StaticResource MaterialDesignComboBox}" Margin="5"></ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="Образование" Style="{StaticResource MaterialDesignBody1TextBlock}" FontSize="16"/>
                                        <ComboBox Style="{StaticResource MaterialDesignComboBox}" Margin="5"></ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</Page>
